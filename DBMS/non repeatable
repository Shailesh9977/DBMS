CREATE TABLE products (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    price INT,
    stock INT
);

INSERT INTO products VALUES
(1, 'Laptop', 50000, 10);

START TRANSACTION;

SELECT price, stock
FROM products
WHERE id = 1;

-- Output: 50000, 10

START TRANSACTION;

UPDATE products
SET price = 45000,
    stock = 8
WHERE id = 1;

COMMIT;

SELECT price, stock
FROM products
WHERE id = 1;

-- Output: 45000, 8

COMMIT;
